# Asset co hash trong ten -> cache vinh vien, an toan vi doi noi dung la doi ten file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html KHONG duoc cache lau, neu khong nguoi dung ket o ban cu sau moi lan deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
